{
  "name": "mila",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "validate:data": "bun scripts/validate-data.ts",
    "audio:generate": "bun scripts/generate-mila-audio.ts",
    "sources": "bun scripts/sources.ts",
    "lint": "oxlint --deny-warnings",
