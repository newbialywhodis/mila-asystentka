  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "mascotz": "1.3.0",
    "next": "16.4.6",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
